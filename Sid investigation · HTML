<style>
:root {
  --black: #03060d;
  --deep: #07101c;
  --panel: #0a0e0a;
  --border: #2a1f0a;
  --gold: #d6b46a;
  --gold-dim: #8a6a2f;
  --gold-muted: #7f693d;
  --gold-bright: #f1e0a8;
  --text: #c8b080;
  --muted: #6a5530;
  --white: #f0ede4;
  --blood: #8a1f1f;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--black);
  color: var(--text);
  font-family: 'Share Tech Mono', monospace;
  overflow-x: hidden;
  min-height: 100vh;
}
body::before {
  content: '';
  position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background:
    radial-gradient(ellipse 600px 400px at 50% 20%, rgba(214,180,106,0.06) 0%, transparent 70%),
    repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(214,180,106,0.01) 3px, rgba(214,180,106,0.01) 4px);
}

/* TICKER */
.ticker-wrap { position: fixed; top: 0; left: 0; right: 0; z-index: 100; height: 26px; overflow: hidden; background: rgba(3,6,13,0.98); border-bottom: 1px solid var(--border); }
.ticker { display: flex; white-space: nowrap; animation: tick 50s linear infinite; }
.tick-item { display: flex; align-items: center; gap: 8px; padding: 0 28px; height: 26px; font-size: 8px; letter-spacing: 0.3em; color: var(--muted); }
.tick-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--gold); }
@keyframes tick { from{transform:translateX(0)} to{transform:translateX(-50%)} }

/* NAV */
nav { position: fixed; top: 26px; left: 0; right: 0; z-index: 99; display: flex; align-items: center; justify-content: space-between; padding: 10px 24px; background: rgba(3,6,13,0.95); border-bottom: 1px solid var(--border); backdrop-filter: blur(10px); }
.nav-logo { font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 0.3em; color: var(--gold); text-decoration: none; }
.nav-links { display: flex; gap: 20px; list-style: none; }
.nav-links a { font-size: 9px; letter-spacing: 0.2em; color: var(--muted); text-decoration: none; transition: color 0.15s; }
.nav-links a:hover { color: var(--gold); }
.nav-back { font-size: 9px; letter-spacing: 0.2em; color: var(--muted); text-decoration: none; border: 1px solid var(--border); padding: 5px 14px; transition: all 0.15s; }
.nav-back:hover { border-color: var(--gold-dim); color: var(--gold); }
@media(max-width:600px){.nav-links{display:none;}}

/* WRAP */
.wrap { position: relative; z-index: 1; max-width: 800px; margin: 0 auto; padding: 90px 20px 60px; }

/* FILE HEADER */
.file-header { border: 1px solid var(--gold-dim); padding: 28px; margin-bottom: 20px; position: relative; overflow: hidden; }
.file-header::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, transparent, var(--gold), transparent); }
.file-header-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; }
.file-meta { font-size: 9px; letter-spacing: 0.2em; color: var(--muted); line-height: 1.8; }
.file-no-box { border: 1px solid var(--gold-dim); padding: 8px 14px; text-align: right; }
.file-no-label { font-size: 8px; letter-spacing: 0.2em; color: var(--muted); margin-bottom: 4px; }
.file-no-value { font-size: 11px; letter-spacing: 0.2em; color: var(--gold); }
.file-title { font-family: 'VT323', monospace; font-size: clamp(3rem, 12vw, 6rem); color: var(--gold); letter-spacing: 0.1em; line-height: 0.9; margin-bottom: 8px; text-shadow: 0 0 40px rgba(214,180,106,0.2); }
.file-subtitle { font-family: 'Cinzel', serif; font-size: clamp(11px, 2vw, 14px); letter-spacing: 0.35em; color: var(--gold-dim); margin-bottom: 6px; }
.file-tagline { font-size: 11px; letter-spacing: 0.15em; color: var(--muted); margin-bottom: 20px; }
.file-divider { height: 1px; background: linear-gradient(90deg, transparent, var(--gold-dim), transparent); opacity: 0.4; margin-bottom: 20px; }
.file-hook { font-size: clamp(13px, 2.5vw, 16px); color: var(--gold-bright); line-height: 1.9; max-width: 580px; }

/* WHAT THIS IS */
.section { margin-bottom: 24px; }
.section-header { font-size: 9px; letter-spacing: 0.3em; color: var(--gold-dim); border: 1px solid var(--border); padding: 8px 16px; margin-bottom: 16px; background: rgba(214,180,106,0.02); }

/* METHODOLOGY */
.method-flow { display: flex; flex-direction: column; gap: 0; margin-bottom: 20px; }
.method-layer { border: 1px solid var(--border); padding: 20px; position: relative; background: rgba(7,10,7,0.6); transition: border-color 0.2s; }
.method-layer:hover { border-color: var(--gold-dim); }
.method-layer::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; }
.layer-source::before { background: var(--gold); }
.layer-cipher::before { background: var(--gold-dim); }
.layer-draconic::before { background: #6a4a8a; }
.layer-vedic::before { background: #4a6a8a; }
.layer-tropical::before { background: #2a8a6a; }
.layer-integration::before { background: var(--gold); }
.method-arrow { text-align: center; padding: 6px; color: var(--gold-dim); font-size: 14px; }
.layer-no { font-size: 8px; letter-spacing: 0.3em; color: var(--muted); margin-bottom: 6px; }
.layer-name { font-family: 'Cinzel', serif; font-size: 1rem; color: var(--gold); margin-bottom: 4px; }
.layer-desc { font-size: 11px; color: var(--muted); line-height: 1.6; }
.layer-highlight { font-size: 10px; color: var(--gold-dim); margin-top: 6px; font-style: italic; }

/* WHAT YOU GET */
.deliverables { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
@media(max-width:600px){.deliverables{grid-template-columns:1fr;}}
.deliverable { border: 1px solid var(--border); padding: 16px; background: rgba(7,10,7,0.6); }
.del-icon { font-size: 20px; margin-bottom: 8px; opacity: 0.7; }
.del-title { font-size: 11px; letter-spacing: 0.15em; color: var(--gold); margin-bottom: 4px; }
.del-desc { font-size: 10px; color: var(--muted); line-height: 1.6; }

/* PRICE */
.price-panel { border: 1px solid var(--gold-dim); padding: 32px; text-align: center; position: relative; overflow: hidden; margin-bottom: 20px; background: rgba(7,10,7,0.9); }
.price-panel::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, transparent, var(--gold), transparent); }
.price-panel::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--gold-dim), transparent); }
.price-tag { font-size: 8px; letter-spacing: 0.4em; color: var(--muted); margin-bottom: 12px; }
.price-amount { font-family: 'VT323', monospace; font-size: 5rem; color: var(--gold); line-height: 1; margin-bottom: 8px; }
.price-note { font-size: 10px; color: var(--muted); margin-bottom: 24px; line-height: 1.6; }
.price-includes { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-bottom: 28px; }
.price-tag-item { font-size: 9px; letter-spacing: 0.15em; color: var(--gold-dim); border: 1px solid var(--border); padding: 4px 10px; }
.btn-submit { display: block; width: 100%; max-width: 400px; margin: 0 auto 12px; background: none; border: 1px solid var(--gold); color: var(--gold); font-family: 'Share Tech Mono', monospace; font-size: 11px; letter-spacing: 0.3em; padding: 16px 32px; cursor: pointer; text-decoration: none; text-align: center; transition: all 0.2s; }
.btn-submit:hover { background: var(--gold); color: var(--black); }
.btn-secondary { display: block; width: 100%; max-width: 400px; margin: 0 auto; background: none; border: 1px solid var(--border); color: var(--muted); font-family: 'Share Tech Mono', monospace; font-size: 10px; letter-spacing: 0.2em; padding: 12px 32px; cursor: pointer; text-decoration: none; text-align: center; transition: all 0.2s; }
.btn-secondary:hover { border-color: var(--gold-dim); color: var(--gold); }

/* EVIDENCE LOG */
.evidence-log { border: 1px solid var(--border); padding: 20px; margin-bottom: 20px; background: rgba(7,10,7,0.6); }
.ev-header { font-size: 9px; letter-spacing: 0.3em; color: var(--gold-dim); margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
.ev-item { display: flex; gap: 10px; font-size: 11px; color: var(--muted); line-height: 1.6; margin-bottom: 8px; }
.ev-bullet { color: var(--gold-dim); flex-shrink: 0; }

/* INVESTIGATOR NOTE */
.inv-note { border: 1px solid var(--border); padding: 20px; margin-bottom: 20px; background: rgba(7,10,7,0.6); }
.inv-header { font-size: 9px; letter-spacing: 0.3em; color: var(--gold-dim); margin-bottom: 12px; }
.inv-text { font-size: 13px; color: var(--gold-bright); line-height: 1.9; }

/* CASE STATUS */
.case-footer { display: flex; gap: 10px; margin-bottom: 20px; }
.case-box { flex: 1; border: 1px solid var(--border); padding: 12px 16px; background: rgba(7,10,7,0.6); }
.case-label { font-size: 8px; letter-spacing: 0.2em; color: var(--muted); margin-bottom: 4px; }
.case-value { font-size: 13px; letter-spacing: 0.15em; color: var(--gold); }

/* PAGE FOOTER */
footer { padding: 30px 24px; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; position: relative; z-index: 1; }
.footer-logo { font-family: 'Cinzel', serif; font-size: 10px; color: var(--muted); letter-spacing: 0.2em; }
.footer-links { display: flex; gap: 16px; flex-wrap: wrap; }
.footer-links a { font-size: 9px; letter-spacing: 0.15em; color: var(--muted); text-decoration: none; transition: color 0.15s; }
.footer-links a:hover { color: var(--gold); }
.footer-copy { font-size: 9px; color: var(--muted); }

@keyframes fadeUp { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }
</style>
