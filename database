<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Institution Floor — SID Operations Center</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=VT323&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--black:#030303;--panel:#0b0b0b;--panel2:#101010;--border:#1c1c1c;--muted:#5b5b5b;--text:#aaa;--white:#f0f0f0;--cyan:#00d4ff;--gold:#d4a017;--green:#4de8b0}
*{box-sizing:border-box;margin:0;padding:0}body{background:var(--black);color:var(--text);font-family:'Share Tech Mono',monospace;min-height:100vh}.wrap{max-width:1180px;margin:auto;padding:30px 22px 70px}.top{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid var(--border);padding-bottom:20px;margin-bottom:20px}.eyebrow{font-size:9px;letter-spacing:.25em;color:var(--cyan)}h1{font-family:'VT323';font-size:clamp(3rem,8vw,5.5rem);color:var(--white);line-height:.9}.back{color:var(--muted);text-decoration:none;font-size:10px}.status-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border:1px solid var(--border);margin-bottom:18px}.status-strip div{background:var(--panel);padding:14px}.status-strip span{display:block;font-size:8px;color:var(--muted);letter-spacing:.16em}.status-strip strong{font-family:'VT323';font-size:1.7rem;color:var(--white);font-weight:normal}.floor{display:grid;grid-template-columns:1.6fr .9fr;gap:14px}.panel{background:var(--panel);border:1px solid var(--border)}.panel-head{padding:13px 15px;border-bottom:1px solid var(--border);font-size:10px;letter-spacing:.14em;color:var(--white)}.desks{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:12px}.desk{border:1px solid var(--border);background:var(--panel2);padding:14px;min-height:145px}.desk-top{display:flex;justify-content:space-between}.desk h3{font-family:'VT323';font-size:1.7rem;color:var(--white)}.light{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 10px rgba(77,232,176,.5)}.desk small{display:block;color:var(--muted);font-size:8px;letter-spacing:.13em;margin-bottom:10px}.desk p{font-size:10px;line-height:1.7}.stage{display:inline-block;margin-top:10px;border:1px solid var(--border);padding:4px 7px;font-size:8px;color:var(--gold)}.scribe{border-color:rgba(0,212,255,.4)}.scribe h3{color:var(--cyan)}.feed,.queue{padding:10px;display:grid;gap:8px}.feed{max-height:700px;overflow:auto}.feed-item{border-left:2px solid var(--cyan);background:var(--panel2);padding:11px}.feed-item strong{display:block;color:var(--white);font-size:10px}.feed-item span{display:block;color:var(--muted);font-size:9px;line-height:1.6}.feed-item time{display:block;color:#383838;font-size:8px;margin-top:5px}.file{border:1px solid var(--border);padding:13px;background:var(--panel2)}.file-head{display:flex;justify-content:space-between;gap:10px}.file strong{display:block;color:var(--white);font-size:11px;font-weight:normal}.file small{color:var(--muted);font-size:8px}.badge{font-size:8px;color:var(--gold)}.file p{font-size:9px;line-height:1.6;margin-top:7px}.file a{display:inline-block;margin-top:8px;color:var(--cyan);font-size:9px}.empty{padding:30px;text-align:center;color:var(--muted);font-size:10px}@media(max-width:900px){.floor{grid-template-columns:1fr}.status-strip{grid-template-columns:1fr 1fr}.desks{grid-template-columns:1fr 1fr}}@media(max-width:520px){.desks,.status-strip{grid-template-columns:1fr}}
</style>
</head>
<body>
<main class="wrap">
<header class="top"><div><div class="eyebrow">// SID OPERATIONS CENTER</div><h1>INSTITUTION FLOOR</h1></div><a class="back" href="index.html">← OPERATIONS CENTER</a></header>
<section class="status-strip"><div><span>ANALYST DESKS</span><strong>08</strong></div><div><span>PUBLISHING DESK</span><strong>SCRIBE</strong></div><div><span>FILES IN QUEUE</span><strong id="queueCount">—</strong></div><div><span>INSTITUTION STATUS</span><strong>ACTIVE</strong></div></section>
<div class="floor">
<div>
<section class="panel"><div class="panel-head">ANALYST & OPERATIONS DESKS</div><div class="desks">
<article class="desk"><div class="desk-top"><h3>SCAR</h3><i class="light"></i></div><small>BEHAVIORAL INTELLIGENCE</small><p>Reviewing behavior logs, defense patterns, and relational recurrence.</p><span class="stage">FIELD REVIEW</span></article>
<article class="desk"><div class="desk-top"><h3>CENTRA</h3><i class="light"></i></div><small>FORENSIC ASTROLOGY</small><p>Cross-checking chart architecture, timing, and system agreement.</p><span class="stage">SYSTEM CHECK</span></article>
<article class="desk"><div class="desk-top"><h3>LUX</h3><i class="light"></i></div><small>ORIGINAL TEXT</small><p>Retrieving source language, early translations, and textual context.</p><span class="stage">SOURCE RETRIEVAL</span></article>
<article class="desk"><div class="desk-top"><h3>CIPHER</h3><i class="light"></i></div><small>NUMERIC INTELLIGENCE</small><p>Mapping sequences, gematria records, and numerical structure.</p><span class="stage">SEQUENCE ANALYSIS</span></article>
<article class="desk"><div class="desk-top"><h3>LUNA</h3><i class="light"></i></div><small>PATTERN INVESTIGATION</small><p>Testing recurrence against context, sequence, and contradiction.</p><span class="stage">PATTERN REVIEW</span></article>
<article class="desk"><div class="desk-top"><h3>RELIC</h3><i class="light"></i></div><small>SYMBOL ARCHIVE</small><p>Checking cultural, archaeological, and historical symbol records.</p><span class="stage">ARCHIVE SEARCH</span></article>
<article class="desk"><div class="desk-top"><h3>NIX</h3><i class="light"></i></div><small>CROSS-SYSTEM SYNTHESIS</small><p>Comparing findings while preserving disagreement between systems.</p><span class="stage">AWAITING MULTI-DIVISION FILE</span></article>
<article class="desk"><div class="desk-top"><h3>ASH</h3><i class="light"></i></div><small>FINAL ASSESSMENT</small><p>Reviews completed evidence records ready for closure.</p><span class="stage">FINAL REVIEW</span></article>
<article class="desk scribe"><div class="desk-top"><h3>SCRIBE</h3><i class="light"></i></div><small>INSTITUTIONAL PUBLISHING</small><p>Validates approved files, builds HTML, updates the index, and prepares GitHub review.</p><span class="stage">PUBLICATION DESK ONLINE</span></article>
</div></section>
<section class="panel" style="margin-top:14px"><div class="panel-head">PUBLICATION QUEUE</div><div class="queue" id="queue"><div class="empty">// LOADING FILES...</div></div></section>
</div>
<aside class="panel"><div class="panel-head">LIVE INSTITUTION ACTIVITY</div><div class="feed" id="activityFeed"><div class="empty">// WAITING FOR ACTIVITY...</div></div></aside>
</div>
</main>
<script src="../assets/js/supabase-client.js"></script>
<script>
async function initFloor(){const session=await requireAuth();if(!session)return;await Promise.all([loadQueue(),loadActivity()]);subscribeToActivity()}
async function loadQueue(){const{data,error}=await supabaseClient.from('archive_files').select('id,file_code,title,division_name,lead_analyst,publication_status,scribe_stage,github_pr_url,publication_error,last_updated').in('publication_status',['under_review','approved','publishing','revision_required']).order('last_updated',{ascending:false});const box=document.getElementById('queue');if(error){box.innerHTML='<div class="empty">QUEUE ERROR: '+esc(error.message)+'</div>';return}document.getElementById('queueCount').textContent=String(data.length).padStart(2,'0');if(!data.length){box.innerHTML='<div class="empty">NO FILES IN THE PUBLICATION QUEUE.</div>';return}box.innerHTML=data.map(file=>'<article class="file"><div class="file-head"><div><small>'+esc(file.division_name||'')+'</small><strong>'+esc(file.file_code+' // '+file.title)+'</strong></div><span class="badge">'+esc((file.scribe_stage||file.publication_status||'').toUpperCase().replaceAll('_',' '))+'</span></div><p>Lead: '+esc(file.lead_analyst||'—')+(file.publication_error?'<br>Issue: '+esc(file.publication_error):'')+'</p>'+(file.github_pr_url?'<a href="'+esc(file.github_pr_url)+'" target="_blank" rel="noopener">OPEN GITHUB REVIEW →</a>':'')+'</article>').join('')}
async function loadActivity(){const{data,error}=await supabaseClient.from('institution_activity').select('*').order('created_at',{ascending:false}).limit(30);const feed=document.getElementById('activityFeed');if(error){feed.innerHTML='<div class="empty">ACTIVITY ERROR: '+esc(error.message)+'</div>';return}renderActivity(data||[])}
function renderActivity(rows){const feed=document.getElementById('activityFeed');if(!rows.length){feed.innerHTML='<div class="empty">NO ACTIVITY FILED YET.</div>';return}feed.innerHTML=rows.map(row=>'<article class="feed-item"><strong>'+esc(row.actor+' // '+row.action)+'</strong><span>'+esc((row.file_code?row.file_code+' — ':'')+(row.detail||row.stage||''))+'</span><time>'+new Date(row.created_at).toLocaleString()+'</time></article>').join('')}
function subscribeToActivity(){supabaseClient.channel('sid-institution-floor').on('postgres_changes',{event:'INSERT',schema:'public',table:'institution_activity'},()=>{loadActivity();loadQueue()}).subscribe()}
function esc(value){const d=document.createElement('div');d.textContent=value||'';return d.innerHTML}initFloor();
</script>
</body></html>
